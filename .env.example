# Django
DEBUG=True
SECRET_KEY=change-me-in-production

# Kimi API Platform (OpenAI-compatible)
# Get a key from https://platform.moonshot.ai
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
KIMI_REASONING_EFFORT=low
KIMI_THINKING=disabled

# CV parsing cost controls
KIMI_MAX_TOKENS_PER_REQUEST=10000
KIMI_MAX_TOKENS_PER_DAY=100000
KIMI_MAX_CALLS_PER_DAY=50
KIMI_MAX_DOLLARS_PER_DAY=1.00
KIMI_INPUT_PRICE_PER_1M=0.00
KIMI_OUTPUT_PRICE_PER_1M=0.00

# CV upload limits
CV_MAX_FILE_SIZE_MB=5
CV_MAX_PAGES=10
CV_MAX_TEXT_CHARS=30000
CV_MAX_DOCX_SIZE_MB=20
CV_PARSE_TIMEOUT_SECONDS=15
